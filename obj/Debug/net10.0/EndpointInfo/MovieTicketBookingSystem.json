  "components": {
    "schemas": {
      "CreateBookingRequest": {
        "required": [
          "showId",
          "customerName",
          "customerEmail",
          "customerPhone",
          "seatIds"
        ],
        "type": "object",
        "properties": {
          "showId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "customerName": {
            "maxLength": 100,
            "type": "string"
          },
          "customerEmail": {
            "maxLength": 150,
            "type": "string"
          },
          "customerPhone": {
            "maxLength": 15,
            "type": "string"
          },
          "seatIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        }
      },
      "Movie": {
        "type": "object",
        "properties": {
          "movieId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "durationMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "releaseDate": {
            "type": "string",
            "format": "date"
          },
          "language": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          }
        }
      },
      "Screen": {
        "required": [
          "theatreId",
          "screenName"
        ],
        "type": "object",
        "properties": {
          "screenId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "theatreId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "screenName": {
            "maxLength": 50,
            "type": "string"
          }
        }
      },
      "Seat": {
        "required": [
          "screenId",
          "rowName",
          "seatNumber",
          "seatType"
        ],
        "type": "object",
        "properties": {
          "seatId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "screenId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rowName": {
            "maxLength": 5,
            "type": "string"
          },
          "seatNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "seatType": {
            "maxLength": 30,
            "type": "string"
          }
        }
      },
      "Show": {
        "required": [
          "movieId",
          "screenId",
          "startTime",
          "endTime",
          "ticketPrice"
        ],
        "type": "object",
        "properties": {
          "showId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "movieId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "screenId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "ticketPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "Theatre": {
        "required": [
          "name",
          "location"
        ],
        "type": "object",
        "properties": {
          "theatreId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "maxLength": 150,
            "type": "string"
          },
          "location": {
            "maxLength": 200,
            "type": "string"
          },
          "screens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Screen"
            }
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
